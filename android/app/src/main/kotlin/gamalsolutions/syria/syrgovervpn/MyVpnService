package gamalsolutions.syria.syrgovervpn

import android.app.*
import android.content.Context
import android.content.Intent
import android.net.VpnService
import android.os.Build
import android.os.ParcelFileDescriptor
import androidx.core.app.NotificationCompat
import com.wireguard.android.backend.Backend
import com.wireguard.android.backend.GoBackend
import com.wireguard.android.backend.Tunnel
import com.wireguard.config.*
import kotlinx.coroutines.*
import java.net.InetSocketAddress

class MyVpnService : VpnService() {

    companion object {
        private const val CHANNEL_ID = "vpn_channel"
        private const val NOTIF_ID = 1001
        private const val ACTION_CONNECT = "connect"
        private const val ACTION_DISCONNECT = "disconnect"
        private const val ACTION_KICK = "kick"

        @Volatile private var instance: MyVpnService? = null

        fun start(ctx: Context, args: Map<String, Any>) {
            val i = Intent(ctx, MyVpnService::class.java).apply {
                action = ACTION_CONNECT
                args.forEach { (k, v) ->
                    when (v) {
                        is String -> putExtra(k, v)
                        is Int -> putExtra(k, v)
                    }
                }
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O)
                ctx.startForegroundService(i)
            else ctx.startService(i)
        }

        fun stop(ctx: Context) {
            ctx.startService(Intent(ctx, MyVpnService::class.java).apply {
                action = ACTION_DISCONNECT
            })
        }

        fun kick() {
            instance?.let {
                it.backend?.let { b ->
                    try {
                        b.getState(it.tunnel)
                    } catch (_: Throwable) {}
                }
            }
        }
    }

    private var tunnel: WgTunnel? = null
    private var backend: GoBackend? = null
    private var lastArgs: Map<String, Any>? = null
    private val scope = CoroutineScope(Dispatchers.IO + SupervisorJob())

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_CONNECT -> {
                startForeground(NOTIF_ID, buildNotification("جارٍ الاتصال..."))
                val args = mutableMapOf<String, Any>()
                intent.extras?.keySet()?.forEach { k ->
                    intent.extras?.get(k)?.let { args[k] = it }
                }
                lastArgs = args
                connect(args)
            }
            ACTION_DISCONNECT -> {
                scope.launch {
                    try {
                        tunnel?.let { t ->
                            t.state = Tunnel.State.DOWN
                            backend?.setState(t, Tunnel.State.DOWN, null)
                        }
                        VpnStateBus.set("disconnected")
                    } catch (e: Throwable) {
                        VpnStateBus.set("error", e.message)
                    } finally {
                        stopForeground(STOP_FOREGROUND_REMOVE)
                        stopSelf()
                    }
                }
            }
            ACTION_KICK -> kick()
        }
        return START_STICKY
    }

    private fun connect(args: Map<String, Any>) {
        instance = this
        scope.launch {
            try {
                VpnStateBus.set("connecting", configName = args["configName"] as? String)

                if (prepare(this@MyVpnService) != null) {
                    VpnStateBus.set("error", "صلاحية VPN مطلوبة")
                    return@launch
                }

                val cfg = buildConfig(args)
                backend = GoBackend(this@MyVpnService)
                val t = WgTunnel()
                tunnel = t
                backend!!.setState(t, Tunnel.State.UP, cfg)
                VpnStateBus.set("connected", configName = args["configName"] as? String)
                updateNotification("متصل")
            } catch (e: Throwable) {
                VpnStateBus.set("error", e.message ?: e.toString())
                updateNotification("خطأ")
            }
        }
    }

    private fun buildConfig(args: Map<String, Any>): Config {
        val iface = Interface.Builder()
            .parsePrivateKey(args["privateKey"] as String)
            .parseAddresses((args["address"] as String).split(","))
            .parseDnsServers((args["dns"] as String).split(","))
            .build()

        val peer = Peer.Builder()
            .parsePublicKey(args["peerPublicKey"] as String)
            .parseEndpoint(args["endpoint"] as String)
            .parseAllowedIPs((args["allowedIps"] as String).split(","))
            .parsePersistentKeepalive((args["persistentKeepalive"] as Int).toString())
            .build()

        // MTU يُضبط عبر Config.Builder
        return Config.Builder().setInterface(iface).addPeer(peer).build()
    }

    private fun buildNotification(text: String): Notification {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val ch = NotificationChannel(
                CHANNEL_ID, "VPN", NotificationManager.IMPORTANCE_LOW
            )
            (getSystemService(NOTIFICATION_SERVICE) as NotificationManager)
                .createNotificationChannel(ch)
        }
        return NotificationCompat.Builder(this, CHANNEL_ID)
            .setContentTitle("My VPN")
            .setContentText(text)
            .setSmallIcon(android.R.drawable.ic_lock_lock)
            .setOngoing(true)
            .build()
    }

    private fun updateNotification(text: String) {
        val nm = getSystemService(NOTIFICATION_SERVICE) as NotificationManager
        nm.notify(NOTIF_ID, buildNotification(text))
    }

    override fun onDestroy() {
        scope.cancel()
        instance = null
        super.onDestroy()
    }
}

/** تنفيذ Tunnel البسيط */
class WgTunnel : Tunnel {
    @Volatile private var _name: String = "myvpn"
    @Volatile private var _state: Tunnel.State = Tunnel.State.DOWN

    override fun getName(): String = _name
    override fun onStateChange(newState: Tunnel.State) { _state = newState }
    var state: Tunnel.State
        get() = _state
        set(v) { _state = v }
}
